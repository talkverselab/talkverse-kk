 "turns": [
  {
   "num": 1,
   "speaker": "C",
   "tl": "Шай ішіңіз. Сүт қосайын ба?",
   "rd": "샤이 이싱이즈. 쉬트 코사인 바?",
   "ko": "차 드세요. 우유 넣어 줄까요?",
   "note": "сүт қосу = 우유를 넣다",
   "tags": [],
   "new": [],
   "emotion": "polite"
  },
  {
   "num": 2,
   "speaker": "A",
   "tl": "Иә, рахмет. Дәмді екен!",
